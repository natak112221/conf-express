<%- include('partials/head', { title: 'Мои заявки' }) %>
<h1>Мои заявки</h1>
<% if (!items.length) { %>
  <p>Заявок пока нет. <a href="/">Выберите мероприятие</a>.</p>
<% } else { %>
<table>
  <tr><th>№</th><th>Мероприятие</th><th>Дата</th><th>Помещение</th><th>Оплата</th><th>Статус</th></tr>
  <% items.forEach(function (a) { %>
  <tr>
    <td><%= a.id %></td>
    <td><a href="/events/<%= a.event_id %>"><%= a.title %></a></td>
    <td><%= fmt.fmtDate(a.starts_at) %></td>
    <td><%= a.room %></td>
    <td><%= a.payment %></td>
    <td><%= a.status %></td>
  </tr>
  <% }) %>
</table>
<% } %>
<%- include('partials/foot') %>
