<form method="post" action="/login">
  <p><label>Логин <input name="login" value="<%= login %>"></label></p>
  <p><label>Пароль <input type="password" name="password"></label></p>
  <p><button>Войти</button></p>
</form>
<%- include('partials/foot') %>
