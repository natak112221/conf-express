<%- include('partials/head', { title: 'Панель администратора' }) %>
<h1>Панель администратора</h1>
<table>
  <tr><th>№</th><th>Участник</th><th>Мероприятие</th><th>Помещение</th><th>Оплата</th><th>Статус</th></tr>
  <% items.forEach(function (a) { %>
  <tr>
    <td><%= a.id %></td>
    <td><%= a.login %><br><%= a.email %><br><%= a.phone %></td>
    <td><%= a.title %><br><%= fmt.fmtDate(a.starts_at) %></td>
    <td><%= a.room %></td>
    <td><%= a.payment %></td>
    <td>
      <form method="post" action="/admin/applications/<%= a.id %>/status">
        <%- include('partials/csrf') %>
        <select name="status">
          <% statuses.forEach(function (s) { %><option <%= s === a.status ? 'selected' : '' %>><%= s %></option><% }) %>
        </select>
        <button>Сохранить</button>
      </form>
    </td>
  </tr>
  <% }) %>
</table>
<%- include('partials/foot') %>
