<%- include('partials/head', { title: 'Панель администратора' }) %>
<h1>Панель администратора</h1>
<form method="get" action="/admin" class="filter">
  <label>Статус
    <select name="status">
      <option value="">Все</option>
      <% statuses.forEach(function (s) { %><option <%= filter.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
    </select>
  </label>
  <label>Мероприятие
    <select name="event">
      <option value="">Все</option>
      <% events.forEach(function (e) { %><option value="<%= e.id %>" <%= filter.eventId === e.id ? 'selected' : '' %>><%= e.title %></option><% }) %>
    </select>
  </label>
  <button>Показать</button> <a href="/admin">Сбросить</a>
</form>
<p>Найдено заявок: <b><%= items.length %></b></p>
<% items.forEach(function (a) { %>
<div class="card">
  <p class="status"><%= a.status %></p>
  <h3>Заявка №<%= a.id %>: <%= a.title %></h3>
  <p><%= fmt.fmtDateTime(a.starts_at) %></p>
  <p>Участник: <%= a.login %>, <%= a.email %>, <%= a.phone %></p>
  <p>Помещение: <%= a.room %>. Оплата: <%= a.payment %>.</p>
  <% if (a.review_text) { %><p>Отзыв (<%= a.review_rating %> из 5): <%= a.review_text %></p><% } %>
  <form method="post" action="/admin/applications/<%= a.id %>/status">
    <%- include('partials/csrf') %>
    <input type="hidden" name="back" value="<%= '/admin' + (Object.keys(query).length ? '?' + new URLSearchParams(query).toString() : '') %>">
    <select name="status">
      <% statuses.forEach(function (s) { %><option <%= s === a.status ? 'selected' : '' %>><%= s %></option><% }) %>
    </select>
    <button>Сохранить статус</button>
  </form>
</div>
<% }) %>
<%- include('partials/foot') %>
