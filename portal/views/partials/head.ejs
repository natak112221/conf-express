<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>Конференции.РФ</title>
  <meta name="description" content="Афиша встреч для разработчиков в Москве: выберите мероприятие и подайте заявку.">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/onest-cyrillic-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/app.js" defer></script>
</head>
<body>
<header class="site-header">
  <div class="container header-row">
    <a class="logo" href="/">Конференции<b>.РФ</b></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav" aria-label="Меню"><span></span></button>
    <nav class="nav" id="nav">
      <a href="/" <%- path === '/' ? 'aria-current="page"' : '' %>>Афиша</a>
      <% if (user) { %>
        <a href="/applications" <%- path === '/applications' ? 'aria-current="page"' : '' %>>Мои заявки</a>
        <% if (user.role === 'admin') { %><a href="/admin" <%- path === '/admin' ? 'aria-current="page"' : '' %>>Панель администратора</a><% } %>
        <a href="/cabinet" <%- path === '/cabinet' ? 'aria-current="page"' : '' %>>Кабинет (<%= user.login %>)</a>
        <form action="/logout" method="post"><%- include('csrf') %><button class="link">Выйти</button></form>
      <% } else { %>
        <a href="/login" <%- path === '/login' ? 'aria-current="page"' : '' %>>Вход</a>
        <a href="/register" <%- path === '/register' ? 'aria-current="page"' : '' %>>Регистрация</a>
      <% } %>
    </nav>
  </div>
</header>
<main>
<div class="container">
<% if (flash) { %><p class="flash" role="status"><%= flash %></p><% } %>
