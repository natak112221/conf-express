<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>Конференции.РФ</title>
  <link rel="stylesheet" href="/css/basic.css">
</head>
<body>
<header>
  <a href="/">Конференции.РФ</a> |
  <a href="/">Мероприятия</a>
  <% if (user) { %>
    | <a href="/applications">Мои заявки</a>
    <% if (user.role === 'admin') { %>| <a href="/admin">Панель администратора</a><% } %>
    | <%= user.login %>
    <form action="/logout" method="post" style="display:inline"><button>Выйти</button></form>
  <% } else { %>
    | <a href="/login">Вход</a> | <a href="/register">Регистрация</a>
  <% } %>
</header>
<main>
<% if (flash) { %><p class="flash"><%= flash %></p><% } %>
