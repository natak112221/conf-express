<%- include('partials/head', { title: 'Регистрация' }) %>
<h1>Регистрация</h1>
<% if (Object.keys(errors).length) { %>
  <ul class="errors"><% Object.values(errors).forEach(function (m) { %><li><%= m %></li><% }) %></ul>
<% } %>
<form method="post" action="/register">
  <%- include('partials/csrf') %>
  <p><label>Логин <input name="login" required minlength="3" maxlength="20" pattern="[A-Za-z0-9_]+" title="3-20 символов: латиница, цифры, _" value="<%= values.login || '' %>"></label></p>
  <p><label>Пароль <input type="password" name="password" required minlength="8"></label></p>
  <p><label>Почта <input type="email" name="email" required value="<%= values.email || '' %>"></label></p>
  <p><label>Телефон <input type="tel" name="phone" required value="<%= values.phone || '' %>"></label></p>
  <p><button>Зарегистрироваться</button></p>
</form>
<%- include('partials/foot') %>
