<%- include('partials/head', { title: 'Регистрация' }) %>
<h1>Регистрация</h1>
<form method="post" action="/register" novalidate>
  <%- include('partials/csrf') %>
  <div class="field">
    <label for="login">Логин</label>
    <input id="login" name="login" required minlength="3" maxlength="20" pattern="[A-Za-z0-9_]+" value="<%= values.login || '' %>" <%- errors.login ? 'aria-invalid="true"' : '' %>>
    <% if (errors.login) { %><p class="error"><%= errors.login %></p><% } else { %><p class="hint">3-20 символов: латиница, цифры, _</p><% } %>
  </div>
  <div class="field">
    <label for="password">Пароль</label>
    <input id="password" type="password" name="password" required minlength="8" <%- errors.password ? 'aria-invalid="true"' : '' %>>
    <% if (errors.password) { %><p class="error"><%= errors.password %></p><% } else { %><p class="hint">Не короче 8 символов</p><% } %>
  </div>
  <div class="field">
    <label for="email">Почта</label>
    <input id="email" type="email" name="email" required value="<%= values.email || '' %>" <%- errors.email ? 'aria-invalid="true"' : '' %>>
    <% if (errors.email) { %><p class="error"><%= errors.email %></p><% } %>
  </div>
  <div class="field">
    <label for="phone">Телефон</label>
    <input id="phone" type="tel" name="phone" required placeholder="+7 900 123-45-67" value="<%= values.phone || '' %>" <%- errors.phone ? 'aria-invalid="true"' : '' %>>
    <% if (errors.phone) { %><p class="error"><%= errors.phone %></p><% } %>
  </div>
  <p><button>Зарегистрироваться</button></p>
</form>
<%- include('partials/foot') %>
